    <!-- Main Container -->
    <div class="container">

        <!-- About / Story Section -->
        <section id="about">
            <h2>فلسفة البداية والترميم الذهبي</h2>
            <div class="card">
                <h3>الأصول والرؤية الاستراتيجية</h3>
                <p>تبدأ القصة من شغف عميق بفهم عراقة الفكر الإنساني والأنظمة التقنية المتقدمة. كخريج حاسوب من جامعة عجلون الوطنية بتخصص دقيق في تحليل البيانات وإدارة الشبكات، أؤمن تماماً أن الكسور والشقوق الداخلية لا تُخفى، بل تُعالج وتُطلى بأثمن المعايير الصلبة لتصبح علامة فارقة للقوة والتألق الاستراتيجي.</p>
            </div>
        </section>

        <!-- Experience Section -->
        <section id="experience">
            <h2>المسار المهني والميداني</h2>
            
            <div class="card">
                <span class="date">2025 - الآن</span>
                <h3>محلل ومصمم أنظمة الذكاء الاصطناعي</h3>
                <p>تطوير أطر عمل تحليل البيانات المتقدمة، هندسة لوحات المعلومات باستخدام Python, SQL و Power BI، وتشغيل منصة الوساطة التجارية الحديثة <strong>"Mazzado"</strong> لتطوير رحلات العملاء والحلول التشغيلية الذكية.</p>
            </div>

            <div class="card">
                <span class="date">خبرة 15 شهراً</span>
                <h3>إدارة قواعد البيانات وأنظمة الحسابات - شركة FACT</h3>
                <p>معالجة وحل المشكلات البرمجية المعقدة الخاصة بنظام تطبيق بنك الإسلامي الأردني، إجراء عمليات تدقيق قواعد البيانات لضمان أمن المعلومات، والامتثال لمعايير الجودة المصرفية.</p>
            </div>

            <div class="card">
                <span class="date">خبرة ميدانية متقدمة</span>
                <h3>الإدارة والمبيعات الكبرى (متاجر Max)</h3>
                <p>العمل الاحترافي في متاجر "Max" لمدة 4 أشهر، والذي توّج بتميز استثنائي أسفر عن الترشيح السريع لاستلام إدارة قسم كامل بفضل الكفاءة التشغيلية والقيادية العالية.</p>
            </div>
        </section>

        <!-- Initiatives & Honors Section -->
        <section id="initiatives">
            <h2>صناعة الوعي والمبادرات الوطنية</h2>

            <div class="card">
                <span class="date">التميز الوطني والملكي</span>
                <h3>التكريمات والمشاركات الرفيعة</h3>
                <p>حائز على <strong>وسام اليوبيل الفضي</strong> كذكرى تذكارية رفيعة المستوى مُهداة من الديوان الملكي الهاشمي. وحققت <strong>المركز الثاني على مستوى المملكة</strong> في الانتخابات النيابية التجريبية (ديسمبر 2023).</p>
            </div>

            <div class="card">
                <span class="date">الفكر والمجتمع</span>
                <h3>صناعة الوعي والمبادرات المرشحة مؤسسياً</h3>
                <p>إنتاج محتوى مرئي وهادف عبر منصات التواصل الاجتماعي يستهدف تحفيز التفكير البشري العميق والوعي المعرفي. قيادة وتأسيس مبادرات وطنية بارزة تم ترشيحها ملكياً ومؤسسياً مثل <strong>"ذوي فكر"</strong> و<strong>"في فكر الحسن"</strong>.</p>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="skills">
            <h2>المهارات والخبرات التخصصية</h2>
            <div class="skills-grid">
                <div class="skill-badge">تصميم وهندسة أنظمة الذكاء الاصطناعي</div>
                <div class="skill-badge">تحليل البيانات الضخمة (Big Data)</div>
                <div class="skill-badge">Python, SQL & Power BI</div>
                <div class="skill-badge">التسويق الاستراتيجي وإدارة المبيعات</div>
                <div class="skill-badge">صناعة المحتوى الفكري والتوعوي</div>
                <div class="skill-badge">إدارة المشاريع والتخطيط</div>
                <div class="skill-badge">بناء العلاقات المؤسسية والقيادية</div>
                <div class="skill-badge">التفكير النقدي وحل المشكلات</div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact">
            <h2>تواصل معي</h2>
            <div class="card contact-content">
                <p>أرحب دائماً بالتعاون في المشاريع التقنية المبتكرة، الاستشارات الاستراتيجية، والنقاشات الفكرية العميقة.</p>
                <a href="mailto:YZNBADARNEH@GMAIL.COM" class="btn">راسلني عبر البريد الإلكتروني</a>
                <div class="social-links">
                    <a href="mailto:YZNBADARNEH@GMAIL.COM" title="البريد الإلكتروني"><i class="fas fa-envelope"></i></a>
                    <a href="https://github.com" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
                    <a href="https://linkedin.com" target="_blank" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </section>

    </div>

    <!-- Footer -->
    <footer>
        <p>جميع الحقوق محفوظة © 2026 | يزن هشام بدارنة</p>
    </footer>

