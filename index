<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>يزن هشام بدارنة | Yazan Badarneh - مهندس أنظمة ومفكر استراتيجي</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-color: #030406;
            --card-bg: rgba(10, 14, 19, 0.90);
            --card-hover: rgba(16, 22, 30, 0.95);
            --accent-gold: #c5a059;
            --accent-gold-light: #dfc17f;
            --text-main: #f4f0ea;
            --text-muted: #abb4be;
            --border-gold: rgba(197, 160, 89, 0.45);
            --shadow-lux: 0 15px 35px rgba(0, 0, 0, 0.9);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Cairo', 'Amiri', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.9;
            overflow-x: hidden;
            position: relative;
        }

        /* خلفية الرخام الأسود والذهبي المحلية مع طبقة عزل خفيفة لوضوح النصوص */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                linear-gradient(to bottom, rgba(3, 4, 6, 0.75), rgba(3, 4, 6, 0.92)),
                url('marble-bg.jpg') no-repeat center center fixed;
            background-size: cover;
            pointer-events: none;
            z-index: -1;
        }

        /* Header / Navbar */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(3, 4, 6, 0.95);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border-gold);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 8%;
        }

        .logo {
            font-family: 'Amiri', serif;
            font-size: 1.6rem;
            color: var(--accent-gold);
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav ul li a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.3s ease;
            font-weight: 600;
        }

        nav ul li a:hover {
            color: var(--accent-gold);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            position: relative;
            border-bottom: 1px solid var(--border-gold);
        }

        .hero-img-container {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            border: 2px solid var(--accent-gold);
            padding: 6px;
            margin-bottom: 25px;
            background: rgba(0,0,0,0.85);
            box-shadow: 0 0 30px rgba(197, 160, 89, 0.3);
        }

        .hero-img-container img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .hero h1 {
            font-family: 'Amiri', serif;
            font-size: 3.5rem;
            color: var(--accent-gold);
            margin-bottom: 15px;
            font-weight: 700;
            letter-spacing: 1px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }

        .hero p {
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 750px;
            margin-bottom: 35px;
        }

        .btn {
            display: inline-block;
            background: transparent;
            color: var(--accent-gold);
            border: 1px solid var(--accent-gold);
            padding: 12px 35px;
            border-radius: 3px;
            text-decoration: none;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.4s ease;
        }

        .btn:hover {
            background: var(--accent-gold);
            color: var(--bg-color);
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(197, 160, 89, 0.5);
        }

        /* Container */
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 80px 20px;
        }

        section {
            padding: 70px 0;
            border-bottom: 1px solid rgba(197, 160, 89, 0.15);
        }

        section h2 {
            font-family: 'Amiri', serif;
            font-size: 2.3rem;
            color: var(--accent-gold);
            margin-bottom: 45px;
            text-align: center;
            position: relative;
        }

        section h2::after {
            content: '';
            display: block;
            width: 70px;
            height: 2px;
            background: var(--accent-gold);
            margin: 12px auto 0;
        }

        /* Interactive Story Cards */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-gold);
            border-radius: 6px;
            padding: 35px;
            margin-bottom: 30px;
            box-shadow: var(--shadow-lux);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; right: 0; width: 4px; height: 100%;
            background: var(--accent-gold);
            opacity: 0.8;
        }

        .card:hover {
            transform: translateY(-6px);
            background: var(--card-hover);
            border-color: var(--accent-gold-light);
            box-shadow: 0 20px 40px rgba(197, 160, 89, 0.2);
        }

        .card h3 {
            font-family: 'Amiri', serif;
            color: var(--accent-gold-light);
            font-size: 1.6rem;
            margin-bottom: 12px;
        }

        .card .date {
            font-size: 0.85rem;
            color: var(--accent-gold);
            margin-bottom: 18px;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 600;
        }

        .card p {
            color: var(--text-muted);
            margin-bottom: 15px;
            font-size: 1.02rem;
        }

        /* Skills Tags */
        .skills-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            justify-content: center;
        }

        .skill-badge {
            background: rgba(197, 160, 89, 0.05);
            color: var(--accent-gold-light);
            border: 1px solid var(--border-gold);
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .skill-badge:hover {
            background: var(--accent-gold);
            color: var(--bg-color);
            transform: translateY(-3px);
            box-shadow: 0 0 15px rgba(197, 160, 89, 0.4);
        }

        /* Contact Section */
        .contact-content {
            text-align: center;
        }

        .contact-content p {
            font-size: 1.15rem;
            color: var(--text-muted);
            margin-bottom: 30px;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 25px;
            font-size: 1.6rem;
            margin-top: 25px;
        }

        .social-links a {
            color: var(--accent-gold);
            transition: all 0.3s ease;
        }

        .social-links a:hover {
            color: var(--text-main);
            transform: scale(1.2);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 35px;
            background: #020304;
            color: var(--text-muted);
            font-size: 0.9rem;
            border-top: 1px solid var(--border-gold);
            letter-spacing: 1px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 { font-size: 2.5rem; }
            nav ul { display: none; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">يزن بدارنة</div>
        <nav>
            <ul>
                <li><a href="#about">القصة</a></li>
